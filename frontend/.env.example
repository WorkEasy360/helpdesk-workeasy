# Backend API the browser talks to.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Optional: Socket.IO origin (defaults to the API origin).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Server-side fetches from the Next server (runtime, not inlined). In production
# Compose: http://api:4000/api/v1
API_INTERNAL_URL=http://localhost:4000/api/v1
# Optional, shown in the app.
# NEXT_PUBLIC_APP_VERSION=
#
# Production: NEXT_PUBLIC_* are BUILD args of frontend/Dockerfile (inlined into the
# bundle and the CSP), e.g. NEXT_PUBLIC_API_URL=https://desk.example.com/api/v1 —
# see deploy/docker-compose.prod.yml.
