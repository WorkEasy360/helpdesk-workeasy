# Rendered by the nginx image's entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Only ${DOMAIN} is substituted; nginx's own $variables pass through untouched.
#
# Single hostname: https://${DOMAIN}
#   /api/...        -> api:4000   REST, auth cookies (path /api), the Workeasy360 sign-in
#                                 routes (/api/auth/...), provider webhooks
#                                 (/api/v1/webhooks/<channel>/<secret>)
#   /socket.io/...  -> api:4000   Socket.IO, namespaces /rt (agents) and /chat
#                                 (help-center chat widget) share this one path
#   everything else -> web:3000   Next.js (agent app + /help/<slug> portal)

server_tokens off;

# Docker's embedded DNS. Upstreams are resolved per request (via the variables below),
# so nginx starts even if api/web are still starting and follows them across restarts.
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# The Workeasy360 sign-in routes carry single-use secrets in the query string (the callback's
# ?code=&state=, the start redirect's state/nonce). This format logs the path ($uri) and never
# the query, and is used for /api/auth/ only.
log_format no_query '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                    '$status $body_bytes_sent "$http_user_agent"';

gzip on;
gzip_proxied any;
gzip_vary on;
gzip_min_length 1024;
gzip_types application/json application/javascript text/css text/plain image/svg+xml;

# --- :80 — ACME challenges, health, and a redirect for everything else --------------
server {
    listen 80 default_server;
    server_name ${DOMAIN} _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Container healthcheck (compose), never reachable as a useful public endpoint.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# --- :443 --------------------------------------------------------------------------
server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Security headers (CSP, HSTS, X-Frame-Options, nosniff, Referrer-Policy) are set by
    # the apps themselves — helmet on the API, next.config.mjs on the web — so nginx
    # adds none, to avoid duplicated or conflicting values.

    # Uploads are capped at ATTACHMENT_MAX_BYTES (25 MB) by the API; inbound webhooks
    # at WEBHOOK_BODY_LIMIT (~36 MB by default, base64 attachments). Keep this above both.
    client_max_body_size 40m;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;

    set $api_upstream http://api:4000;
    set $web_upstream http://web:3000;

    location /api/auth/ {
        access_log /var/log/nginx/access.log no_query;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_pass $api_upstream;
    }

    location /api/ {
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_pass $api_upstream;
    }

    location /socket.io/ {
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
        proxy_pass $api_upstream;
    }

    location / {
        proxy_set_header Connection "";
        proxy_pass $web_upstream;
    }
}
