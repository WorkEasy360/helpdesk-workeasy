# ---------------------------------------------------------------------------
# Digisoft360 Help Desk — PRODUCTION environment for deploy/docker-compose.prod.yml
#
#   cp .env.example .env && chmod 600 .env
#
# Compose uses this file twice: for ${...} substitution in docker-compose.prod.yml,
# and as the environment of the api, worker and migrate containers. Never commit .env.
# Lines marked [generate] need a fresh random value — the command is beside each.
# ---------------------------------------------------------------------------

# --- Host / compose (read by docker-compose.prod.yml, not by the apps) --------------
# The single public hostname. nginx serves the web app, /api/ and /socket.io/ on it.
# FRONTEND_URL, BACKEND_URL, PUBLIC_API_URL and the web build args are derived from it
# in docker-compose.prod.yml — do not set those here.
DOMAIN=desk.example.com
# Where Let's Encrypt sends expiry warnings.
LETSENCRYPT_EMAIL=ops@example.com
# Image tag for digisoft-api / digisoft-worker / digisoft-web (deploy.sh sets it to the git sha).
IMAGE_TAG=latest
# Image names are <IMAGE_PREFIX>-api/-worker/-web. `digisoft` = built on this host;
# the GitHub Actions deploy uses ghcr.io/<owner>/helpdesk and sets IMAGE_TAG itself.
IMAGE_PREFIX=digisoft
# Optional, shown in the web app (NEXT_PUBLIC_APP_VERSION, baked at build time).
APP_VERSION=
# [generate] openssl rand -hex 32     (hex: it is embedded in REDIS_URL, keep it URL-safe)
REDIS_PASSWORD=replace-me-openssl-rand-hex-32

# --- Runtime ------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
PORT=4000
API_PREFIX=api/v1

# --- Database: shared Aurora/RDS PostgreSQL, own schema + least-privilege role ------
# Created by deploy/sql/01-create-role-and-schema.sql. Notes:
#  - ?schema=helpdesk puts every table, enum and _prisma_migrations in that schema only.
#  - URL-encode special characters in the password (@ : / ? # % -> %40 %3A %2F %3F %23 %25),
#    or generate one without them: openssl rand -hex 24
#  - sslmode=require encrypts without verifying the CA. To verify, download the RDS CA
#    bundle (https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem), mount
#    it into the api/worker/migrate containers and add &sslrootcert=/path/global-bundle.pem
#    (with sslmode=verify-full).
#  - connection_limit is per process: api + worker = 2 x 10 connections at most.
#  - Always the WRITER (cluster) endpoint, never the reader endpoint.
DATABASE_URL=postgresql://helpdesk_app:REPLACE_PASSWORD@my-cluster.cluster-xxxxxxxx.ap-south-1.rds.amazonaws.com:5432/existing_db?schema=helpdesk&sslmode=require&connection_limit=10

# --- Authentication -----------------------------------------------------------------
# [generate] openssl rand -base64 48      (the two must differ)
JWT_SECRET=replace-me-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-me-another-openssl-rand-base64-48
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
COOKIE_SECURE=true
# Leave unset for the single-hostname setup (host-only cookies are the tightest scope).
# COOKIE_DOMAIN=

# --- Proxy and request limits (added in this hardening pass) ------------------------
# nginx is exactly one hop in front of the API.
TRUST_PROXY=1
# JSON / form body ceiling. Attachments (multipart) are governed by ATTACHMENT_MAX_BYTES.
BODY_LIMIT=1mb
# Inbound channel webhooks; unset = ATTACHMENT_MAX_BYTES x 1.4 + 1 MB (~36 MB).
# WEBHOOK_BODY_LIMIT=
# true only until the first organization is registered through the UI; then set to
# false and `docker compose ... up -d api` so nobody else can create an organization.
ALLOW_PUBLIC_REGISTRATION=true

# --- Rate limiting ------------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=10

# --- Email: Amazon SES API, credentials from the EC2 instance role -----------------
EMAIL_PROVIDER=ses
AWS_REGION=ap-south-1
# Must be on an SES-verified domain (DKIM) — see deploy/README.md.
EMAIL_FROM="Digisoft360 Help Desk <support@example.com>"

# --- Attachments and report exports: S3, credentials from the EC2 instance role ----
STORAGE_PROVIDER=s3
S3_BUCKET=example-helpdesk-attachments
S3_REGION=ap-south-1
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=300
ATTACHMENT_MAX_BYTES=26214400
# Leave S3_ENDPOINT, S3_ACCESS_KEY and S3_SECRET_KEY OUT entirely (not even `KEY=`):
# with no keys the AWS SDK uses the instance role, and an empty S3_ENDPOINT is passed
# through to the SDK as an empty endpoint.
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- Channels -----------------------------------------------------------------------
# [generate] openssl rand -base64 32   Encrypts channel credentials and the per-org
# Anthropic key at rest. Losing or changing it makes stored credentials unreadable.
CHANNEL_ENCRYPTION_KEY=replace-me-openssl-rand-base64-32
WEBHOOK_MAX_ATTEMPTS=5

# --- Worker -------------------------------------------------------------------------
WORKER_CONCURRENCY=5
SLA_SCAN_INTERVAL_SECONDS=60
METRICS_ROLLUP_INTERVAL_SECONDS=900
METRICS_ROLLUP_DAYS=2
