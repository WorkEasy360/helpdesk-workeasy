{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendEmailFromVerifiedDomain",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": [
        "arn:aws:ses:REGION:ACCOUNT_ID:identity/example.com",
        "arn:aws:ses:REGION:ACCOUNT_ID:configuration-set/*"
      ]
    },
    {
      "Sid": "AttachmentObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::example-helpdesk-attachments/*"
    }
  ]
}
