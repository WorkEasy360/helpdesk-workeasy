# ---------------------------------------------------------------------------
# Digisoft360 Help Desk — PRODUCTION app variables for the api and worker processes.
#
# For the supported deployment (Docker Compose on one EC2 host) use
# deploy/.env.example instead — it is the canonical template and additionally holds
# DOMAIN, REDIS_PASSWORD, LETSENCRYPT_EMAIL and IMAGE_TAG, from which Compose derives
# the URLs below. This file lists the same variables fully spelled out, for running
# the images under another orchestrator (ECS, Kubernetes, systemd). Never commit it
# with real values.
# ---------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
PORT=4000
API_PREFIX=api/v1

# Single public hostname; nginx/ALB routes /api/ and /socket.io/ to the API.
FRONTEND_URL=https://desk.example.com
BACKEND_URL=https://desk.example.com
PUBLIC_API_URL=https://desk.example.com

# Shared Aurora/RDS: own schema + least-privilege role (deploy/sql/01-create-role-and-schema.sql).
DATABASE_URL=postgresql://helpdesk_app:REPLACE_PASSWORD@my-cluster.cluster-xxxxxxxx.ap-south-1.rds.amazonaws.com:5432/existing_db?schema=helpdesk&sslmode=require&connection_limit=10
# Password-protected, never publicly reachable. openssl rand -hex 32
REDIS_URL=redis://:replace-me-openssl-rand-hex-32@redis:6379

# openssl rand -base64 48 (each; must differ)
JWT_SECRET=replace-me-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-me-another-openssl-rand-base64-48
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
COOKIE_SECURE=true

# Added in this hardening pass
TRUST_PROXY=1
BODY_LIMIT=1mb
ALLOW_PUBLIC_REGISTRATION=false

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=10

# SES via the instance/task role (no keys).
EMAIL_PROVIDER=ses
AWS_REGION=ap-south-1
EMAIL_FROM="Digisoft360 Help Desk <support@example.com>"

# S3 via the instance/task role. Do NOT add empty S3_ENDPOINT / S3_ACCESS_KEY / S3_SECRET_KEY lines.
STORAGE_PROVIDER=s3
S3_BUCKET=example-helpdesk-attachments
S3_REGION=ap-south-1
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=300
ATTACHMENT_MAX_BYTES=26214400

# openssl rand -base64 32 — back it up; api and worker need the same value.
CHANNEL_ENCRYPTION_KEY=replace-me-openssl-rand-base64-32
WEBHOOK_MAX_ATTEMPTS=5

WORKER_CONCURRENCY=5
SLA_SCAN_INTERVAL_SECONDS=60
METRICS_ROLLUP_INTERVAL_SECONDS=900
METRICS_ROLLUP_DAYS=2

# --- Sign in with Workeasy360 (docs/workeasy360-sso.md) -------------------------------
# Production signs agents in through Workeasy360 only. With WORKEASY360_SSO_ONLY on (the
# default in production) api and worker REFUSE TO START unless all of the following are set.
# The worker needs ISSUER, CLIENT_ID, KEY_ID and the private key (no redirect URI).
WORKEASY360_ISSUER=https://app.workeasy360.com
WORKEASY360_CLIENT_ID=replace-with-the-integration-client-id
# Exactly the redirect URI registered in Workeasy360 (compared as a string: no trailing slash).
WORKEASY360_REDIRECT_URI=https://desk.example.com/api/auth/callback/workeasy360
# The credential id Workeasy360 returned for the public key.
WORKEASY360_KEY_ID=replace-with-the-credential-id
# Inline PEM with literal \n sequences (one line), or mount a file and use WORKEASY360_PRIVATE_KEY_FILE.
WORKEASY360_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----
# WORKEASY360_PRIVATE_KEY_FILE=/run/secrets/workeasy360.key
WORKEASY360_PRODUCT_CODE=easy_helpdesk
WORKEASY360_SCOPES=openid email profile organization
# Registered in Workeasy360 as a post-logout redirect URI of this integration.
WORKEASY360_POST_LOGOUT_REDIRECT_URI=https://desk.example.com/login
WORKEASY360_DEFAULT_ROLE=AGENT
WORKEASY360_SSO_ONLY=true
# Sign-in starts/callbacks per client address per minute, per route. Raise it for an office behind one
# shared (NATed) address.
# WORKEASY360_SIGN_IN_RATE_LIMIT=30
# How often an open realtime socket re-checks its person's Easy Help Desk access.
# REALTIME_ACCESS_RECHECK_SECONDS=60
