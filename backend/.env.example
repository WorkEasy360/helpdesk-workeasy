# ---------------------------------------------------------------------------
# Digisoft360 Help Desk — DEVELOPMENT. Copy to .env and fill in. Never commit real secrets.
# Production: deploy/.env.example (Docker Compose on EC2) or .env.production.example.
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- URLs -------------------------------------------------------------------
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# --- Datastores -------------------------------------------------------------
# Point this at your managed PostgreSQL instance to skip the local db container.
DATABASE_URL=postgresql://digisoft:digisoft@localhost:5432/digisoft_helpdesk?schema=public
REDIS_URL=redis://localhost:6379

# --- Authentication ---------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-of-random-data
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me-with-another-32-character-random-string
JWT_REFRESH_EXPIRES_IN_DAYS=30
COOKIE_SECURE=false
# COOKIE_DOMAIN=.digisoft360.com

# --- Proxy, request limits, registration (added in this hardening pass) ------
# Which proxy hops may set X-Forwarded-For/-Proto. Default trusts private networks;
# production behind the compose nginx: 1.
# TRUST_PROXY=loopback, linklocal, uniquelocal
# JSON/form body ceiling (attachments use ATTACHMENT_MAX_BYTES).
BODY_LIMIT=1mb
# Set to false once the first organization exists (production).
ALLOW_PUBLIC_REGISTRATION=true

# --- Rate limiting ----------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=10

# --- Email ------------------------------------------------------------------
# console (logs the message) | smtp | ses
EMAIL_PROVIDER=smtp
EMAIL_FROM="Digisoft360 Help Desk <no-reply@digisoft360.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# AWS_REGION=ap-south-1

# --- Attachment storage -----------------------------------------------------
# local = files on disk, streamed back through the API (development, single node)
# s3    = any S3-compatible bucket, downloads handed out as short-lived signed URLs
STORAGE_PROVIDER=local
# Absolute, and shared by the API and the worker — they run from different working
# directories, and in Docker from different containers mounting the same volume.
STORAGE_LOCAL_PATH=/var/lib/digisoft/storage
ATTACHMENT_MAX_BYTES=26214400
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=digisoft-helpdesk
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true      # true for MinIO, false for AWS S3
# S3_SIGNED_URL_TTL_SECONDS=300

# --- Worker -----------------------------------------------------------------
WORKER_CONCURRENCY=5

# --- Seed -------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@digisoft360.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Channels (Phase 5) -------------------------------------------------------
# 32 bytes, base64 or hex. Required before a channel can store provider credentials.
# Generate with: openssl rand -base64 32
CHANNEL_ENCRYPTION_KEY=
# Public base URL providers post webhooks to (defaults to BACKEND_URL).
PUBLIC_API_URL=
# Attempts per outbound webhook delivery before it is marked failed.
WEBHOOK_MAX_ATTEMPTS=5

# --- AI assistant -------------------------------------------------------------
# The workspace assistant (the chat button on every agent page) runs on the
# deployment's own key, set here. HEURISTIC is the default and needs nothing: the chat
# still works, answering from the tools alone, and says it has no model behind it.
# Set a real provider and the API refuses to start without AI_API_KEY.
#
#   ANTHROPIC  AI_MODEL defaults to claude-opus-5     key: console.anthropic.com
#   GEMINI     AI_MODEL defaults to gemini-2.5-flash  key: aistudio.google.com
#   HEURISTIC  no key, no model, no network
#
# AI_MODEL is optional: unset, each provider uses its own default.
#
# The per-ticket insights (summary, sentiment, intent, suggested reply) are separate and
# stay per organization, in Settings -> Assistant, so each tenant bills its own account.
# Those are Anthropic-only.
AI_PROVIDER=HEURISTIC
# AI_MODEL=
# AI_API_KEY=
