# ---------------------------------------------------------------------------
# Digisoft360 Help Desk — DEVELOPMENT. Copy to .env and fill in. Never commit real secrets.
# Production: deploy/.env.example (Docker Compose on EC2) or .env.production.example.
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- URLs -------------------------------------------------------------------
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# --- Datastores -------------------------------------------------------------
# Point this at your managed PostgreSQL instance to skip the local db container.
DATABASE_URL=postgresql://digisoft:digisoft@localhost:5432/digisoft_helpdesk?schema=public
REDIS_URL=redis://localhost:6379

# --- Authentication ---------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-of-random-data
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me-with-another-32-character-random-string
JWT_REFRESH_EXPIRES_IN_DAYS=30
COOKIE_SECURE=false
# COOKIE_DOMAIN=.digisoft360.com

# --- Proxy, request limits, registration (added in this hardening pass) ------
# Which proxy hops may set X-Forwarded-For/-Proto. Default trusts private networks;
# production behind the compose nginx: 1.
# TRUST_PROXY=loopback, linklocal, uniquelocal
# JSON/form body ceiling (attachments use ATTACHMENT_MAX_BYTES).
BODY_LIMIT=1mb
# Set to false once the first organization exists (production).
ALLOW_PUBLIC_REGISTRATION=true

# --- Rate limiting ----------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=10

# --- Email ------------------------------------------------------------------
# console (logs the message) | smtp | ses
EMAIL_PROVIDER=smtp
EMAIL_FROM="Digisoft360 Help Desk <no-reply@digisoft360.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# AWS_REGION=ap-south-1

# --- Attachment storage -----------------------------------------------------
# local = files on disk, streamed back through the API (development, single node)
# s3    = any S3-compatible bucket, downloads handed out as short-lived signed URLs
STORAGE_PROVIDER=local
# Absolute, and shared by the API and the worker — they run from different working
# directories, and in Docker from different containers mounting the same volume.
STORAGE_LOCAL_PATH=/var/lib/digisoft/storage
ATTACHMENT_MAX_BYTES=26214400
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=digisoft-helpdesk
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true      # true for MinIO, false for AWS S3
# S3_SIGNED_URL_TTL_SECONDS=300

# --- Worker -----------------------------------------------------------------
WORKER_CONCURRENCY=5

# --- Seed -------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@digisoft360.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Channels (Phase 5) -------------------------------------------------------
# 32 bytes, base64 or hex. Required before a channel can store provider credentials.
# Generate with: openssl rand -base64 32
CHANNEL_ENCRYPTION_KEY=
# Public base URL providers post webhooks to (defaults to BACKEND_URL).
PUBLIC_API_URL=
# Attempts per outbound webhook delivery before it is marked failed.
WEBHOOK_MAX_ATTEMPTS=5


# --- Sign in with Workeasy360 (docs/workeasy360-sso.md) -------------------------------
# Optional in development: leave these empty and password sign-in keeps working with no
# Workeasy360 running. To rehearse the real flow, register a development integration whose
# redirect URI is http://localhost:4000/api/auth/callback/workeasy360 (Workeasy360 accepts
# http://localhost outside production), fill in the values and set WORKEASY360_SSO_ONLY=false
# (both ways in) or true (Workeasy360 only). The worker reads the same ISSUER / CLIENT_ID /
# KEY_ID / PRIVATE_KEY values so background jobs can re-check an organization's access.
WORKEASY360_ISSUER=
WORKEASY360_CLIENT_ID=
WORKEASY360_REDIRECT_URI=
WORKEASY360_KEY_ID=
# The private key, as a file (preferred) or inline PEM (literal \n allowed). Keep it outside the repo.
WORKEASY360_PRIVATE_KEY_FILE=
WORKEASY360_PRIVATE_KEY=
# WORKEASY360_PRODUCT_CODE=easy_helpdesk
# WORKEASY360_SCOPES=openid email profile organization
# Registered in Workeasy360 as the integration's post-logout URI; enables "Sign out of
# Easy Help Desk and Workeasy360".
# WORKEASY360_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login
# System role for people joining an existing organization: ADMIN, AGENT or LIGHT_AGENT (never SUPER_ADMIN).
# WORKEASY360_DEFAULT_ROLE=AGENT
# true: Workeasy360 is the only way agents sign in (password sign-in, registration, password
# reset and invitations are refused). Default: true in production, false elsewhere.
WORKEASY360_SSO_ONLY=false
# Sign-in starts/callbacks per client address per minute, per route. Raise it for an office behind one
# shared (NATed) address.
# WORKEASY360_SIGN_IN_RATE_LIMIT=30
# How often an open realtime socket re-checks its person's Easy Help Desk access.
# REALTIME_ACCESS_RECHECK_SECONDS=60
